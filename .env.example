DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/site_gpt_db

LLM_AI=ollama
LLM_MODEL=qwen3.5:latest
LLM_EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest

OPENAI_API_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=your_key
GEMINI_API_KEY=your_key
OPEN_ROUTER_API_KEY=your_key
GROQ_API_KEY=your_key

OLLAMA_HOST=http://localhost:11434
OLLAMA_USERNAME=
OLLAMA_PASSWORD=

MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_TLS=true
MAIL_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Frontend URL (used in password-reset emails) + CORS allow-list.
# Use a comma-separated list in production; "*" disables credentials.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=*

# Worker auto re-crawl interval in hours (0 disables the scheduler).
CRAWL_REFRESH_HOURS=24

# Verbose SQL logging for debugging. Leave false in production.
SQL_ECHO=false

# --- Multi-source uploads (Google Drive, etc.) ---
# The backend imports files from external sources by normalizing them into a
# local file under uploads/. No backend secret is required for Google Drive:
# the frontend obtains an OAuth access token via the Google Picker popup and
# sends it with the request. These values are only needed if you later enable
# a service-account flow or surface a "Connect Drive" button in the UI.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_ENABLED=false