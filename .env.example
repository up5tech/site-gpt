DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/site_gpt_db

LLM_AI=ollama
LLM_MODEL=qwen3.5:latest
LLM_EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest

# Embedding provider is fully independent of the chat provider. Leave unset to
# reuse LLM_AI. Examples:
#   chat=ollama/qwen, embeddings=openai/text-embedding-3-small -> EMBEDDING_AI=openai
#   chat=openai/gpt-5,  embeddings=ollama/bge-m3            -> EMBEDDING_AI=ollama
EMBEDDING_AI=ollama
# Vector dimension of the `embeddings` column. Must equal the embedding model's
# output dim (e.g. 1024 for bge-m3, 768 for nomic-embed-text). Changing it
# requires an Alembic migration + re-ingest.
EMBEDDING_DIMENSIONS=1536

# Deployment profile. "production" makes startup fail closed with setting
# NAMES only until all of these are set: JWT_SECRET_KEY (not the dev fallback),
# an explicit CORS_ORIGINS list, SQL_ECHO=false, RATE_LIMIT_BACKEND=redis,
# API_KEY_PEPPER, INTEGRATION_WEBHOOK_SECRET, TRUSTED_PROXY_IPS and
# DOCS_ENABLED=false. Leave "development" for local runs and the test suite.
APP_ENV=development
# Serve /docs, /redoc and /openapi.json. Must be false in production.
DOCS_ENABLED=true

OPENAI_API_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=your_key
GEMINI_API_KEY=your_key
OPEN_ROUTER_API_KEY=your_key
GROQ_API_KEY=your_key

OLLAMA_HOST=http://localhost:11434
OLLAMA_USERNAME=
OLLAMA_PASSWORD=

MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_TLS=true
MAIL_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# V5 Stripe billing is off by default; no Stripe account or secrets are needed
# unless you explicitly enable billing. Never copy these secrets into VITE_*.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Explicit Stripe API version pinned to the installed stripe SDK major version.
STRIPE_API_VERSION=2026-11-18.endive
# Private plan-code → Stripe Price ID mapping (never public, never in VITE_*).
# Comma-separated `code:interval=price_...` entries or a JSON object:
#   STRIPE_PRICE_IDS=starter:month=price_123,starter:year=price_456
# A plan with no mapping cannot be bought; Checkout fails closed.
STRIPE_PRICE_IDS=

# Frontend URL (used in password-reset emails and, when billing is implemented,
# fixed Stripe return URLs) + CORS allow-list. Use a comma-separated list in
# production; "*" disables credentials.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=*

# IPs/CIDRs of reverse proxies or load balancers (comma-separated) whose
# X-Forwarded-For may be trusted. Loopback/private peers are trusted
# automatically; list a public LB here so rate limiting keys on the real
# visitor IP instead of the LB address. Leave empty when not behind one.
TRUSTED_PROXY_IPS=

# Worker auto re-crawl interval in hours (0 disables the scheduler).
CRAWL_REFRESH_HOURS=24

# --- Weekly digest (F6) ---
# DIGEST_ENABLED is the global switch for the worker's digest loop; each company
# additionally needs its own `digest_enabled` setting. DIGEST_CHECK_SECONDS is
# how often the loop looks for companies whose hour has come, and DIGEST_HOUR is
# the default UTC hour for a company without a `digest_hour` setting.
DIGEST_ENABLED=false
DIGEST_CHECK_SECONDS=3600
DIGEST_HOUR=9

# Retrieval quality floor: max cosine distance for a chunk to be used as
# context. Nothing under the threshold -> canned "no information" reply and no
# LLM call. Lower is stricter; a negative value disables the filter.
RAG_MAX_DISTANCE=0.6

# Largest accepted upload or remote import (URL / Google Drive), in MB.
# Enforced while streaming: bigger requests get 413 and leave nothing on disk.
MAX_UPLOAD_MB=20

# Most pages one sitemap sync may create (0 = no cap). A huge sitemap would
# otherwise create tens of thousands of pages in one request, all of which the
# next ingest crawls. Repeated syncs continue where the previous one stopped.
SITEMAP_SYNC_MAX_URLS=500

# Daily chat-message ceiling per website, counted in Redis and reset at UTC
# midnight. When exceeded the visitor gets a friendly reply instead of an LLM
# call. Per-IP rate limiting alone cannot bound a viral embed's spend.
# 0 disables the cap. Counters live only in Redis; flushing Redis resets them.
DAILY_MESSAGE_LIMIT=1000

# Structured JSON log level (V6-22, D8). INFO keeps 4xx/5xx and application
# events; the per-request access event is DEBUG for a success, and DEBUG also
# adds tracebacks to error events (still redacted).
LOG_LEVEL=INFO

# Verbose SQL logging for debugging. Leave false in production.
SQL_ECHO=false

# --- Multi-source uploads (Google Drive, etc.) ---
# The backend imports files from external sources by normalizing them into a
# local file under uploads/. No backend secret is required for Google Drive:
# the frontend obtains an OAuth access token via the Google Picker popup and
# sends it with the request. These values are only needed if you later enable
# a service-account flow or surface a "Connect Drive" button in the UI.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_ENABLED=false

# Pepper for hashing company API keys (`POST /api/api-keys`, `/api/v1`).
# Required in production; changing it invalidates every existing key.
API_KEY_PEPPER=

# HMAC-SHA256 secret used to sign outbound webhook payloads
# (`X-SiteGPT-Signature: sha256=...`). Only the webhook integration needs it.
INTEGRATION_WEBHOOK_SECRET=

# Fallback language for the embeddable widget when the visitor's browser
# language cannot be detected. "auto" follows navigator.language.
DEFAULT_WIDGET_LANGUAGE=auto

# How often the worker retries outbound integration deliveries whose backoff
# has elapsed. Backoff itself is fixed in code (1m, 5m, 30m, 2h, 6h).
DELIVERY_CHECK_SECONDS=60
# How long a settled (delivered/dead) delivery row is kept. A dead row's payload
# is cleared immediately because it can never be retried; 0 keeps the rows.
DELIVERY_RETENTION_DAYS=30
# How often the delivery retention pass runs (default 1 hour). The retry tick is
# DELIVERY_CHECK_SECONDS; deleting is a much slower job than retrying.
DELIVERY_RETENTION_CHECK_SECONDS=3600

# How often the worker queues the per-company retention purge (daily). The purge
# removes visitor rows older than a company's `retention_days` setting.
RETENTION_CHECK_SECONDS=86400

# --- Session tokens (K4) ---
# The widget mints a per-session token so a leaked session id cannot read a
# transcript. "compat" keeps a tokenless read of an unclaimed session working
# for older embeds; set "enforce" once the token-aware snippet is live. See
# docs/security.md.
SESSION_TOKEN_MODE=compat
# Token lifetime in seconds (default 30 days). An expired token can be rotated
# by the visitor who still holds it.
SESSION_TOKEN_TTL_SECONDS=2592000
# Absolute lifetime of one session's token chain (default 180 days), counted from
# its creation. Rotation cannot extend it, so a stolen token dies here even if it
# keeps being renewed.
SESSION_TOKEN_MAX_LIFETIME_SECONDS=15552000

# --- V3 scaffolding (Wave 0; behaviour wired in later waves) ---
# Per-IP rate-limit backend: "memory" (default, V2.1, per-process) or "redis"
# (shared across API processes, V3-10).
RATE_LIMIT_BACKEND=memory
# Per-website embed token mode: "compat" (default; a missing token is accepted)
# or "enforce" (a valid X-Embed-Token is required, V3-23).
EMBED_TOKEN_MODE=compat
# Topic clustering (F2): max visitor questions embedded per run, and the
# worker's scheduler check cadence in seconds (window boundaries come from
# digest_day/normalize_period, not from this cadence).
TOPIC_CLUSTER_MAX_MESSAGES=500
TOPIC_CLUSTER_INTERVAL_SECONDS=86400
# Live-agent inbox (F3): presence lease TTL and SSE heartbeat interval.
INBOX_PRESENCE_TTL_SECONDS=60
INBOX_STREAM_HEARTBEAT_SECONDS=15

# --- V4 scaffolding (Wave 0; behaviour wired in later waves) ---
# Every value below defaults to the V3 behaviour, so leaving this block out keeps
# a deployment identical to tag `v3`.
#
# Per-session message cap (F4): visitor messages one session may send inside one
# idle window. 0 = unlimited (the default). The per-company setting
# `session_message_limit` wins when set. Counted in Redis and checked after the
# per-IP limiter and before the daily quota, so a capped session never spends
# the daily budget; a Redis outage fails open.
SESSION_MESSAGE_LIMIT=0
# How long a session's counter lives, refreshed on every accepted message: the
# cap is an idle window, not a lifetime ban.
SESSION_CAP_TTL_SECONDS=86400
# Daily sitemap diff scan (F4): how often the worker looks for websites whose
# company has `sitemap_scan_enabled=true`. A failed or empty sitemap fetch
# changes nothing.
SITEMAP_SCAN_INTERVAL_SECONDS=86400
# Per-conversation AI insights (F2): cadence and the bounded provider cost per
# run — at most this many settled conversations, this many per LLM call, this
# many transcript characters per conversation, settled this many minutes after
# the last message.
INSIGHT_INTERVAL_SECONDS=86400
INSIGHT_MAX_CONVERSATIONS=50
INSIGHT_BATCH_SIZE=10
INSIGHT_TRANSCRIPT_CHARS=4000
INSIGHT_SETTLE_MINUTES=60
# New training sources (F3): a YouTube playlist/channel expands to at most this
# many videos, a Notion page to at most this many blocks, a Notion database to at
# most this many pages; each of those caps is disabled with 0. Counting a
# database past the import cap costs one query per 100 pages, so `total` is
# exact only while it took at most this many query pages, and a lower bound
# (flagged `total_exact: false`) otherwise; 0 never counts past what the cap
# needs.
YOUTUBE_MAX_VIDEOS=25
NOTION_MAX_BLOCKS=1000
NOTION_MAX_PAGES=25
NOTION_MAX_COUNT_PAGES=10
# Platform-owner console (V5 Wave 4, V5-40). Off by default: /api/platform is a
# 404 until this is true, and the operator grant itself is provisioned only out
# of band with `scripts/platform_owner.py`. Do not enable it in production until
# D5's strong-auth or private-network requirement is approved and in place; with
# APP_ENV=production the API refuses to start while this is true (V6-11).
PLATFORM_CONSOLE_ENABLED=false
# Operations (V6-21, D8). The worker heartbeats into Redis and the API turns
# these numbers into the approved alert set; a value *above* a threshold alerts.
# There is no metrics vendor: `scripts/ops_status.py` reads the snapshot from
# `GET /api/ops/status` and exits 1 on a critical alert.
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_STALE_SECONDS=90
QUEUE_DEPTH_ALERT=100
QUEUE_AGE_ALERT_SECONDS=900
JOB_FAILURE_ALERT_COUNT=3
JOB_FAILURE_WINDOW_SECONDS=3600
API_ERROR_RATE_WINDOW_SECONDS=300
API_ERROR_RATE_ALERT=0.02
API_ERROR_RATE_MIN_REQUESTS=20
# Shared secret for GET /api/ops/status. Empty (the default) disables the route
# with a 404 in every environment: it is operator data, not a tenant feature, so
# the production validator does not require it, but a production boot logs one
# `config.ops_status_disabled` warning so a deployment without an alert path is
# visible. Set it in production and run `scripts/ops_status.py` from a monitor.
OPS_STATUS_TOKEN=
